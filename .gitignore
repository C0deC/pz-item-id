# ==========================================
# PYTHON - .gitignore
# ==========================================

# ------------------
# Byte-compiled / optimized files
# ------------------
__pycache__/
*.py[cod]
*$py.class

# ------------------
# C extensions
# ------------------
*.so

# ------------------
# Distribution / packaging
# ------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------
# PyInstaller
# ------------------
*.manifest
*.spec

# ------------------
# Installer logs
# ------------------
pip-log.txt
pip-delete-this-directory.txt

# ------------------
# Unit test / coverage
# ------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.pytest_cache/

# ------------------
# Type checkers
# ------------------
.mypy_cache/
.pyre/
.pytype/
.pyright/

# ------------------
# Environments
# ------------------
.env
.env.*
!.env.example

venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------
# IDEs / Editors
# ------------------
.vscode/
.idea/
*.swp
*.swo
*.code-workspace
*~

# ------------------
# Jupyter Notebook
# ------------------
.ipynb_checkpoints/

# ------------------
# Ruff / Linters
# ------------------
.ruff_cache/

# ------------------
# Pylint
# ------------------
.pylint.d/

# ------------------
# Poetry
# ------------------
poetry.toml

# ------------------
# UV
# ------------------
.uv/

# ------------------
# Operating System
# ------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------
# Logs
# ------------------
*.log

# ------------------
# Local configuration
# ------------------
*.local


# ==========================================
# PZ ITEM ID - PROJECT-SPECIFIC
# ==========================================

# ------------------
# Pipeline-generated data
# Regenerable using scripts from tools/
# ------------------
data/icons/
data/icons_mods/
data/icon_index.json
data/items.json
data/items_mods.json
data/translations.json
data/translations_mods.json

